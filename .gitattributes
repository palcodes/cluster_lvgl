# core.autocrlf is true here, which would hand a fresh clone CRLF line
# endings in the working copy.  bash will not run a script whose lines end
# in \r - `sim/build.sh` would fail with `$'\r': command not found` - so
# everything is checked out LF, the way it is stored.
* text=auto eol=lf

# Batch files are the exception: cmd.exe has known trouble with LF around
# labels and goto.
*.bat text eol=crlf

*.png binary
*.ttf binary
